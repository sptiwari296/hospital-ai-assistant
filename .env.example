# Copy this file to .env and fill in values. Never commit .env.
POSTGRES_DB=hospital
POSTGRES_USER=hospital_app
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
HOSPITAL_TIMEZONE=Asia/Kolkata

# Phase 3: LLM provider: groq (default) or claude
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_EFFORT=medium
# only if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Phase 6: API auth
JWT_SECRET=change_me_long_random_string
DEMO_PASSWORD=change_me_demo_password
FRONTEND_ORIGIN=http://localhost:3000

# Phase 7: security
API_DB_USER=hospital_api
API_DB_PASSWORD=change_me_api_db_password
FIELD_ENCRYPTION_KEY=generate_with_Fernet.generate_key()
COOKIE_SECURE=false
